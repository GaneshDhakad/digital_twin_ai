# Digital Twin AI — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/digital_twin_ai

# ── JWT Authentication ────────────────────────────────────────────────────────
SECRET_KEY=change_me_to_a_long_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── LLM Providers ────────────────────────────────────────────────────────────
# Gemini (used for AI Backend Service — Milestone 4)
GEMINI_API_KEY=

# OpenAI (optional, not currently used)
OPENAI_API_KEY=

# ── Redis (optional, for caching) ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
